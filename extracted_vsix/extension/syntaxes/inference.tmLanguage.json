{
    "scopeName": "source.js.inference",
    "injectionSelector": "L:source.js string.quoted -meta.embedded, L:source.ts string.quoted -meta.embedded, L:source.js string.template -meta.embedded, L:source.ts string.template -meta.embedded",
    "patterns": [
        { "include": "#embedded-sql-single" },
        { "include": "#embedded-sql-double" },
        { "include": "#embedded-sql-template" }
    ],
    "repository": {
        "embedded-sql-single": {
            "name": "meta.embedded.block.sql",
            "begin": "(?<=')(?:)(?=(?:[^'\\\\]|\\\\.)*\\b(?:SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|GRANT|REVOKE|START\\s+TRANSACTION|BEGIN|COMMIT|ROLLBACK|SAVEPOINT)\\b)",
            "end": "(?=(?<!\\\\)')",
            "contentName": "source.sql.embedded.js",
            "patterns": [
                {
                    "include": "#escape-string-single"
                },
                {
                    "include": "source.sql"
                }
            ]
        },
        "embedded-sql-double": {
            "name": "meta.embedded.block.sql",
            "begin": "(?<=\")(?:)(?=(?:[^\"\\\\]|\\\\.)*\\b(?:SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|GRANT|REVOKE|START\\s+TRANSACTION|BEGIN|COMMIT|ROLLBACK|SAVEPOINT)\\b)",
            "end": "(?=(?<!\\\\)\")",
            "contentName": "source.sql.embedded.js",
            "patterns": [
                {
                    "include": "#escape-string-double"
                },
                {
                    "include": "source.sql"
                }
            ]
        },
        "embedded-sql-template": {
            "name": "meta.embedded.block.sql",
            "begin": "(?<=`)(?=(?:[^`\\\\]|\\\\.|[\\$]\\{[^}]*\\})*\\b(?:SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|GRANT|REVOKE|START\\s+TRANSACTION|BEGIN|COMMIT|ROLLBACK|SAVEPOINT)\\b)",
            "end": "(?=(?<!\\\\)`)",
            "contentName": "source.sql.embedded.js",
            "patterns": [
                {
                    "begin": "'",
                    "end": "'",
                    "name": "string.quoted.single.sql",
                    "patterns": [
                        {
                            "include": "#js-interpolation"
                        }
                    ]
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.sql",
                    "patterns": [
                        {
                            "include": "#js-interpolation"
                        }
                    ]
                },
                {
                    "include": "#escape-string-template"
                },
                {
                    "include": "#js-interpolation"
                },
                {
                    "include": "source.sql"
                }
            ]
        },
        "js-interpolation": {
            "name": "meta.template.expression.js",
            "begin": "\\${",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.js" }
            },
            "end": "}",
            "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.js" }
            },
            "contentName": "source.js.embedded.expression",
            "patterns": [ { "include": "source.js" } ]
        },
        "escape-string-single": {
            "match": "\\\\(['\\\\nrtvef$]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2})",
            "name": "constant.character.escape.php"
        },
        "escape-string-double": {
            "match": "\\\\([\"\\\\nrtvef$]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2})",
            "name": "constant.character.escape.php"
        },
        "escape-string-template": {
            "match": "\\\\(['\"\\\\nrtvef$]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2})",
            "name": "constant.character.escape.php"
        }
    }
}